# ==============================================================================
# Aperture AIoT Control Center - Environment Configuration
# ==============================================================================

# Application Environment (development, staging, production)
APP_ENV=development

# Database Configuration
# Local SQLite default:
DATABASE_URL=sqlite:///./backend/aperture.db
# PostgreSQL example:
# DATABASE_URL=postgresql://aperture:aperture_secure_password_2026@localhost:5432/aperture_aiot

# Redis Configuration (for caching & distributed pub/sub)
REDIS_URL=redis://localhost:6379/0

# Security & Authentication
JWT_SECRET=generate_a_secure_random_64_character_hex_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (comma-separated or * for wildcard dev)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# BLE Hardware Adapter Configuration
# Vendor-specific endpoints and keys remain strictly behind the adapter boundary
BLE_VENDOR_API_URL=
BLE_VENDOR_API_KEY=
BLE_ADAPTER_SIMULATION_ENABLED=true

# Hardware Execution Safety Limits (Hardware Interlock Boundary)
HARDWARE_EXECUTION_LOCAL_ONLY=true
HARDWARE_MAX_RPM=3000.0
HARDWARE_MIN_RPM=0.0
HARDWARE_EMERGENCY_STOP_TIMEOUT_SEC=1.0
HARDWARE_COMMAND_TIMEOUT_SEC=5.0

# Telemetry & Feature Buffer Configuration
TELEMETRY_WINDOW_SIZE=50
TELEMETRY_HOP_SIZE=25
TELEMETRY_SAMPLING_RATE_HZ=50.0

# Storage Paths
MODEL_STORAGE_PATH=./storage/models
DATASET_STORAGE_PATH=./storage/datasets
LOG_STORAGE_PATH=./storage/logs
